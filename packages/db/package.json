{
  "name": "@langopia/db",
  "version": "0.1.0",
  "private": true,
  "description": "Esquema, políticas de aislamiento y seed. Detalle de infraestructura: ningún dominio lo importa.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "tsx src/apply-extensions.ts && drizzle-kit push --force",
    "db:deploy": "drizzle-kit migrate && tsx src/apply-policies.ts",
    "db:studio": "drizzle-kit studio",
    "db:policies": "tsx src/apply-policies.ts",
    "db:seed": "tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "better-auth": "^1.6.25",
    "drizzle-kit": "^0.31.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
