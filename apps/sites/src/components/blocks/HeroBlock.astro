---
import { Picture } from "astro:assets";
import { heroContent } from "../../block-content";
import type { BlockSnapshot } from "../../public-site";

const { block } = Astro.props as { block: BlockSnapshot };
const hero = heroContent(block.props);
const canOptimizeHeroImage = hero.imageUrl?.startsWith("http://") || hero.imageUrl?.startsWith("https://");
---

<section class="hero-block">
  <div class="hero-copy">
    <p class="eyebrow">Academia de idiomas</p>
    <h1>{hero.headline}</h1>
    {hero.subtitle && <p class="subtitle">{hero.subtitle}</p>}
    {
      hero.ctaLabel && hero.ctaHref && (
        <a class="cta" href={hero.ctaHref}>
          {hero.ctaLabel}
        </a>
      )
    }
  </div>
  {
    hero.imageUrl && canOptimizeHeroImage && (
      <Picture
        src={hero.imageUrl}
        alt={hero.imageAlt}
        inferSize
        widths={[720, 1080, 1440]}
        sizes="(max-width: 900px) 100vw, 50vw"
        loading="eager"
        class="hero-image"
      />
    )
  }
  {
    hero.imageUrl && !canOptimizeHeroImage && (
      <img src={hero.imageUrl} alt={hero.imageAlt} loading="eager" class="hero-image" />
    )
  }
</section>

<style>
  .hero-block {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    min-height: min(760px, 92vh);
    padding: clamp(56px, 8vw, 104px) var(--page-gutter) clamp(40px, 6vw, 72px);
    background: linear-gradient(120deg, color-mix(in srgb, var(--brand-primary) 13%, white), #ffffff 64%);
  }

  .hero-copy {
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--brand-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: #10211f;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .subtitle {
    max-width: 620px;
    margin: 24px 0 0;
    color: #41514e;
    font-size: clamp(1.12rem, 2vw, 1.45rem);
    line-height: 1.5;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 32px;
    padding: 0 22px;
    border-radius: 6px;
    background: var(--brand-primary);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 28px 80px rgba(16, 33, 31, 0.16);
  }

  @media (max-width: 860px) {
    .hero-block {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }
</style>
