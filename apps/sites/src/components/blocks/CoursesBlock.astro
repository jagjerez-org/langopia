---
import { selectedIds } from "../../block-content";
import type { BlockSnapshot } from "../../public-site";

const { block } = Astro.props as { block: BlockSnapshot };
const courseIds = selectedIds(block.props, "courseIds");
---

<section class="section courses-block">
  <div class="section-heading">
    <p>Cursos</p>
    <h2>Programas activos</h2>
  </div>
  <div class="course-grid">
    {
      courseIds.length > 0 ? (
        courseIds.map((id, index) => (
          <article class="course-card">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>Curso disponible</h3>
            <p>Programa publicado por la escuela.</p>
            <small>{id}</small>
          </article>
        ))
      ) : (
        <article class="course-card featured">
          <span>Todos</span>
          <h3>Catálogo activo</h3>
          <p>La escuela publica su oferta vigente desde Langopia.</p>
        </article>
      )
    }
  </div>
</section>

<style>
  .courses-block {
    background: #ffffff;
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .course-card {
    min-height: 188px;
    padding: 24px;
    border: 1px solid #dce5e2;
    border-radius: 8px;
    background: #fbfdfc;
  }

  .course-card span,
  .course-card small {
    color: var(--brand-primary);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .course-card h3 {
    margin: 24px 0 10px;
    color: #10211f;
    font-size: 1.35rem;
  }

  .course-card p {
    margin: 0;
    color: #52615e;
    line-height: 1.55;
  }

  .course-card small {
    display: block;
    max-width: 100%;
    margin-top: 16px;
    overflow-wrap: anywhere;
  }

  .featured {
    border-color: color-mix(in srgb, var(--brand-primary) 40%, #dce5e2);
  }
</style>
