# Server
PORT=2501
NODE_ENV=development

# Database
DATABASE_URL=postgresql://langopia:langopia@localhost:5433/langopia

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=6h
JWT_REFRESH_EXPIRATION=7d

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# S3 / MinIO
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=langopia
S3_SECRET_KEY=langopia123
S3_BUCKET=langopia-recordings
S3_REGION=us-east-1

# OpenAI (Whisper + GPT-4o)
OPENAI_API_KEY=your-openai-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PROFESSIONAL_PRICE_ID=price_professional
APP_URL=http://localhost:3000

# Email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Langopia <noreply@langopia.com>

# TTS (optional — at least one provider needed for audio exercises)
ELEVENLABS_API_KEY=
# RunPod XTTS (production)
RUNPOD_API_KEY=
RUNPOD_TTS_ENDPOINT_ID=
# Local XTTS (development, no API key needed)
LOCAL_TTS_URL=http://localhost:8020/tts

# Push Notifications (optional)
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
