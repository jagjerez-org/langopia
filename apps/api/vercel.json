{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "ignoreCommand": "echo 'Deployment handled by GitHub Actions CI' && exit 0",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/v1/cron/purge-expired-recordings", "schedule": "0 3 * * *" },
    { "path": "/api/v1/cron/notify-overdue-attempts", "schedule": "0 5 * * *" }
  ]
}
