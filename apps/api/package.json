{
  "name": "@langopia/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Langopia — hexagonal + DDD + CQRS sobre NestJS",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "npm run db:deploy --workspace @langopia/db && node dist/main.js",
    "bundle:workspace-deps": "node scripts/bundle-workspace-deps.js",
    "vercel-build": "cd ../.. && npm run build --workspace @langopia/contracts && npm run build --workspace @langopia/db && npm run build --workspace @langopia/api && npx @vercel/ncc build apps/api/dist/vercel.js -o apps/api/dist/ncc --external @napi-rs/canvas --external canvas",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@langopia/contracts": "*",
    "@langopia/db": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.1",
    "better-auth": "^1.6.25",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.45.2",
    "intl-messageformat": "^11.2.12",
    "mammoth": "^1.12.0",
    "nestjs-cls": "^5.4.0",
    "nestjs-pino": "^4.6.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@vercel/ncc": "^0.44.1",
    "@vitest/coverage-v8": "^3.2.7",
    "dommatrix": "^1.0.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.7"
  }
}
