# Conexión de superusuario o dueño del esquema. La usan las migraciones,
# la aplicación de políticas y el seed — nunca el código de la aplicación.
DATABASE_URL=postgres://langopia:langopia@localhost:5432/langopia

# Conexión que usa la aplicación. Debe apuntar al rol `langopia_app`, que NO
# tiene BYPASSRLS. Es lo que impide que un fallo en una consulta se convierta
# en una fuga entre escuelas.
DATABASE_URL_APP=postgres://langopia_app:cambiame@localhost:5432/langopia

# Semilla del generador determinista del seed. Cambiarla produce otro conjunto
# de datos de relleno; los casos borde escritos a mano no cambian nunca.
SEED_RANDOM_SEED=20260725

# Better Auth
# `BETTER_AUTH_URL` incluye la ruta a propósito: Better Auth deduce de ella el
# `basePath` de su router. Tiene que coincidir con el prefijo global de Nest
# (`api/v1`) más el controlador (`auth`), o todas sus rutas devuelven 404.
BETTER_AUTH_SECRET=genera-uno-con-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000/api/v1/auth
# Orígenes desde los que se puede iniciar sesión, separados por comas. Better
# Auth valida la cabecera `Origin` en toda ruta que cambia estado y responde
# 403 INVALID_ORIGIN si no está en esta lista; por defecto solo confía en el
# origen de `BETTER_AUTH_URL`, así que el panel —que vive en otro puerto en
# desarrollo y en otro dominio en producción— no podría ni entrar sin esto.
# Sin declarar, se usa el servidor de desarrollo de Vite.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Proveedor de correo del contexto `notifications` (Resend). Sin clave, los
# avisos se registran en el log en vez de enviarse — suficiente en desarrollo;
# en producción la ausencia se registra como error, porque alguien debía
# recibir ese correo y nadie lo hizo. `RESEND_FROM_EMAIL` es el remitente; si
# se omite, se usa notificaciones@langopia.app.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
